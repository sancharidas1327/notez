MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/notez?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Use gridfs for public deployments so uploaded files persist in MongoDB Atlas.
# Use disk only for local development.
STORAGE_DRIVER=gridfs
GRIDFS_BUCKET=noteUploads
UPLOAD_DIR=uploads
